{
  "name": "prosemirror-fragview",
  "version": "0.0.0",
  "description": "A fragmented view for ProseMirror: the editor state rendered into a chain of fragmentainers, each a component that pulls content from a position and gives back the position where it had to stop.",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js"
  },
  "files": [
    "src",
    "docs/plan.md",
    "README.md"
  ],
  "scripts": {
    "test": "node --test test/*.test.js",
    "parity": "node scripts/parity.mjs"
  },
  "peerDependencies": {
    "prosemirror-model": "^1.25.0",
    "prosemirror-state": "^1.4.0",
    "prosemirror-transform": "^1.12.0"
  },
  "repository": {
    "type": "git",
    "url": "https://codeberg.org/egildo/prosemirror-fragview.git"
  },
  "author": "Egildo Tagliareni",
  "private": true,
  "devDependencies": {
    "playwright": "1.63.0",
    "prosemirror-collab": "1.3.1",
    "prosemirror-commands": "1.7.2",
    "prosemirror-history": "1.5.1",
    "prosemirror-inputrules": "1.5.1",
    "prosemirror-keymap": "1.2.3",
    "prosemirror-model": "1.25.12",
    "prosemirror-schema-basic": "1.2.5",
    "prosemirror-schema-list": "1.5.1",
    "prosemirror-state": "1.4.4",
    "prosemirror-test-builder": "1.1.1",
    "prosemirror-transform": "1.12.2",
    "prosemirror-view": "1.42.6",
    "vite": "8.3.4"
  }
}
